      "tdd": {
        "test": {
          "description": "Identify failing scenario or code smell with file:line",
          "passes": true
        },
        "implement": {
          "description": "Minimal fix",
          "passes": true
        },
        "refactor": {
          "passes": true
        }
      },
      "passes": true
