      "tdd": {
        "test": {
          "description": "Document issue with reproduction steps in notes",
          "passes": false
        },
        "implement": {
          "description": "Fix with surgical diff",
          "passes": false
        },
        "refactor": {
          "passes": false
        }
      },
      "passes": false
