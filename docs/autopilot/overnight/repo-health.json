{
  "$schema": "https://raw.githubusercontent.com/Gens-ai/autopilot/main/tasks.schema.json",
  "name": "repo-health",
  "description": "Overnight debug and improvement pass for the Chrome extension",
  "goals": [
    "All Node feedback loops pass",
    "Critical checkout/monitor bugs fixed with tests",
    "Documented overnight summary"
