  "requirements": [
    {
      "id": "1",
      "category": "testing",
      "priority": "high",
      "description": "Fix any failing Node feedback loops (checkout-speed-test, signin-step-test, syntax-check)",
      "recurring": false,
      "verification": [
        "node scripts/checkout-speed-test.mjs",
        "bash scripts/autopilot-syntax-check.sh"
      ],
      "acceptance": [
        "node scripts/checkout-speed-test.mjs exits 0",
        "bash scripts/autopilot-syntax-check.sh exits 0"
      ],
      "tdd": {
        "test": {
          "description": "Run feedback loops and capture failures",
          "passes": true
        },
        "implement": {
          "description": "Fix root cause of any failure",
          "passes": true
        },
        "refactor": {
          "passes": true
        }
      },
      "passes": true
    },
    {
      "id": "2",
      "category": "testing",
      "priority": "high",
      "description": "Keep autopilot-cursor integration test script passing",
      "recurring": false,
      "dependsOn": [
        "1"
      ],
      "verification": [
        "./scripts/test-autopilot-cursor.sh"
      ],
      "acceptance": [
        "./scripts/test-autopilot-cursor.sh exits 0"
