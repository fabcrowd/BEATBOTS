# Copy to .env.rehearsal and fill in (never commit .env.rehearsal)
TCH_TARGET_EMAIL=you@example.com
TCH_TARGET_PASSWORD=your-target-password
TCH_AUTO_SIGNIN=1

# Optional — default is Scotch shipping tape if unset
